    "editorOverviewRuler.warningForeground": "#ff9900",
    "editorWidget.background": "#252320",
    "editorWidget.border": "#43423e",
    "editorSuggestWidget.background": "#252320",
    "editorSuggestWidget.border": "#43423e",
    "editorSuggestWidget.selectedBackground": "#4c4b47",
    "editorSuggestWidget.highlightForeground": "#ffcc00",
    "editorSuggestWidget.focusHighlightForeground": "#ffcc00",
    "editorHoverWidget.background": "#252320",
    "editorHoverWidget.border": "#43423e",
    "editorStickyScroll.background": "#1d1c19",
    "editorStickyScrollHover.background": "#252320",
    "minimap.selectionHighlight": "#ffcc0073",
    "minimap.findMatchHighlight": "#ffcc0099",
    "minimapGutter.addedBackground": "#73c881",
    "minimapGutter.modifiedBackground": "#ffcc00",
    "minimapGutter.deletedBackground": "#e94b4a",

    "diffEditor.insertedTextBackground": "#73c88126",
    "diffEditor.removedTextBackground": "#e94b4a26",
    "diffEditor.insertedLineBackground": "#73c8811a",
    "diffEditor.removedLineBackground": "#e94b4a1a",
    "merge.currentHeaderBackground": "#73c88159",
    "merge.currentContentBackground": "#73c8812e",
    "merge.incomingHeaderBackground": "#a187ff59",
    "merge.incomingContentBackground": "#a187ff2e",

    "gitDecoration.addedResourceForeground": "#73c881",
    "gitDecoration.untrackedResourceForeground": "#73c881",
    "gitDecoration.modifiedResourceForeground": "#ffcc00",
    "gitDecoration.deletedResourceForeground": "#e94b4a",
    "gitDecoration.renamedResourceForeground": "#5fcdf5",
    "gitDecoration.conflictingResourceForeground": "#ff9900",
    "gitDecoration.ignoredResourceForeground": "#605d57",

    "panel.background": "#1d1c19",
    "panel.border": "#383633",
    "panelTitle.activeForeground": "#ebe8e0",
    "panelTitle.activeBorder": "#ffcc00",
    "panelTitle.inactiveForeground": "#7f7b74",
    "statusBar.background": "#2c2b27",
    "statusBar.foreground": "#a9a69d",
