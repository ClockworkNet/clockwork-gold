    "terminal.background": "#1d1c19",
    "terminal.foreground": "#ebe8e0",
    "terminalCursor.foreground": "#ffcc00",
    "terminal.selectionBackground": "#4c4b47",
    "terminal.ansiBlack": "#1d1c19",
    "terminal.ansiRed": "#e94b4a",
    "terminal.ansiGreen": "#73c881",
    "terminal.ansiYellow": "#ffcc00",
    "terminal.ansiBlue": "#4fa3f4",
    "terminal.ansiMagenta": "#ef3ead",
    "terminal.ansiCyan": "#64c3c3",
    "terminal.ansiWhite": "#a9a69d",
    "terminal.ansiBrightBlack": "#4c4b47",
    "terminal.ansiBrightRed": "#ff716b",
    "terminal.ansiBrightGreen": "#88e196",
    "terminal.ansiBrightYellow": "#c89f00",
    "terminal.ansiBrightBlue": "#76c0ff",
    "terminal.ansiBrightMagenta": "#ff68c6",
    "terminal.ansiBrightCyan": "#82e1e0",
    "terminal.ansiBrightWhite": "#fcfaf4"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#79766d", "fontStyle": "italic" }
    },
    {
      "scope": ["comment.block.documentation", "comment.block.javadoc"],
      "settings": { "foreground": "#7f7b74", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage", "storage.type", "storage.modifier", "keyword.operator", "keyword.control"],
      "settings": { "foreground": "#ef3ead" }
    },
    {
      "scope": ["entity.name.tag", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "meta.selector"],
      "settings": { "foreground": "#ef3ead" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "entity.name.class", "entity.name.type.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#ffcc00" }
    },
    {
      "scope": ["entity.name.type", "support.type", "support.class", "entity.name.namespace", "entity.name.type.module", "entity.other.attribute-name", "storage.type.primitive"],
      "settings": { "foreground": "#5fcdf5" }
    },
    {
      "scope": ["entity.other.attribute-name.pseudo-class.css", "entity.other.attribute-name.pseudo-element.css"],
      "settings": { "foreground": "#a187ff" }
    },
    {
      "scope": ["string", "punctuation.definition.string", "string.quoted", "string.template"],
      "settings": { "foreground": "#73c881" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#64c3c3" }
    },
    {
      "scope": ["constant.character.escape", "constant.other.placeholder"],
      "settings": { "foreground": "#a187ff" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "variable.other.enummember"],
      "settings": { "foreground": "#a187ff" }
    },
    {
      "scope": ["variable", "variable.other.readwrite", "variable.other.property", "support.variable.property", "meta.object-literal.key"],
      "settings": { "foreground": "#ebe8e0" }
    },
    {
      "scope": ["variable.parameter", "meta.parameter variable"],
      "settings": { "foreground": "#ff9900", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": { "foreground": "#ff9900", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword.control.directive", "meta.preprocessor", "entity.name.label", "meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#ff9900" }
    },
    {
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.definition.tag"],
      "settings": { "foreground": "#a9a69d" }
    },
    {
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#ef3ead" }
    },
    {
      "scope": ["support.type.property-name.json", "support.type.property-name"],
      "settings": { "foreground": "#5fcdf5" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#ffcc00", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ffcc00", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#fcfaf4", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#5fcdf5" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "#64c3c3" }
    },
    {
      "scope": ["punctuation.definition.list.begin.markdown", "markup.list punctuation.definition"],
      "settings": { "foreground": "#ffcc00" }
    },
    {
      "scope": ["markup.inserted", "punctuation.definition.inserted"],
      "settings": { "foreground": "#73c881" }
    },
    {
      "scope": ["markup.deleted", "punctuation.definition.deleted"],
      "settings": { "foreground": "#e94b4a" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#ffcc00" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#e94b4a" }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#ef3ead",
    "function": "#ffcc00",
    "method": "#ffcc00",
    "class": "#ffcc00",
    "type": "#5fcdf5",
    "interface": "#5fcdf5",
    "enum": "#5fcdf5",
    "namespace": "#5fcdf5",
    "typeParameter": "#5fcdf5",
    "enumMember": "#a187ff",
    "number": "#a187ff",
    "string": "#73c881",
    "regexp": "#64c3c3",
    "variable": "#ebe8e0",
    "property": "#ebe8e0",
    "parameter": { "foreground": "#ff9900", "italic": true },
    "decorator": "#ff9900",
    "comment": { "foreground": "#79766d", "italic": true }
  }
}
