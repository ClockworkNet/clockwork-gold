    "statusBar.debuggingForeground": "#1d1c19",
    "statusBar.noFolderBackground": "#2c2b27",
    "statusBarItem.remoteBackground": "#ffcc00",
    "statusBarItem.remoteForeground": "#1d1c19",
    "statusBarItem.hoverBackground": "#383633",
